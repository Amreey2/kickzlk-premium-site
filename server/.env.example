NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
SITE_URL=https://kickz.lk
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kickz_lk
DB_SSL=false
DB_REQUIRED=true
JWT_CUSTOMER_SECRET=replace-with-at-least-32-random-characters
JWT_ADMIN_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
# Set to 1 in production when one trusted reverse proxy/load balancer terminates HTTPS.
TRUST_PROXY=false
MAX_UPLOAD_MB=8
ADMIN_EMAIL=admin@kickz.lk
ADMIN_PASSWORD=replace-with-a-strong-password
# Leave as /api for the local Vite proxy. In production, use the full API URL
# only when the API is hosted on a separate origin.
VITE_API_URL=/api
