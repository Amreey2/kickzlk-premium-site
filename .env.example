# Leave as /api for the local Vite proxy. In production, use the full API URL
# only when the API is hosted on a separate origin.
VITE_API_URL=/api
VITE_SITE_URL=https://kickz.lk
# Optional. Analytics stays completely disabled when this is empty.
VITE_GA_MEASUREMENT_ID=
VITE_GA_DEBUG=false
# Optional Google Search Console HTML verification token.
VITE_GOOGLE_SITE_VERIFICATION=
